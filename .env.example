# Copy to .env and fill in. Never commit the real .env (it's gitignored).
# get_default_provider() prefers Anthropic > Groq/OpenRouter > offline MockProvider.
# Setting BOTH Groq and OpenRouter wraps them in a FallbackProvider: a daily-quota
# exhaustion on Groq's free tier falls through to OpenRouter's automatically, mid-run.

# Free tier (no card required) — get a key at https://console.groq.com
GROQ_API_KEY=

# Second free-tier source, used when Groq's quota runs out — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Paid, used only if you have credits — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
